{
  "version": 6,
  "configurePresets": [
    {
      "name": "msys2-ucrt64",
      "displayName": "Windows / MSYS2 UCRT64 (GCC + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "msys2-ucrt64-debug",
      "inherits": "msys2-ucrt64",
      "displayName": "Windows / MSYS2 UCRT64 Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msys2-ucrt64-release",
      "inherits": "msys2-ucrt64",
      "displayName": "Windows release / MSYS2 UCRT64 with OpenShape's own OCCT (scripts/windows/build-occt.sh)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPENSHAPE_OWN_OCCT": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (system packages)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Homebrew packages)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "/opt/homebrew"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msys2-ucrt64",
      "configurePreset": "msys2-ucrt64"
    },
    {
      "name": "msys2-ucrt64-debug",
      "configurePreset": "msys2-ucrt64-debug"
    },
    {
      "name": "msys2-ucrt64-release",
      "configurePreset": "msys2-ucrt64-release"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    }
  ],
  "testPresets": [
    {
      "name": "msys2-ucrt64",
      "configurePreset": "msys2-ucrt64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
