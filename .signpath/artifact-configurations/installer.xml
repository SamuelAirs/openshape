<!-- SignPath artifact configuration, slug "installer" (docs/CODE_SIGNING.md).
     The second signing request of .github/workflows/release.yml: the GitHub
     workflow artifact (a ZIP) holds only the NSIS installer
     OpenShape-<version>-windows-x64-setup.exe, made by that run from the
     package with the already signed OpenShape.exe
     (scripts/windows/make-installer.sh, packaging/windows/openshape.nsi).
     It is signed if its name and its version resource (product OpenShape,
     the version the workflow passes: CMakeLists.txt's, e.g. 0.2.0) match.
     SignPath cannot look inside NSIS installers, hence two requests. Paste
     this into the SignPath project's artifact configuration "installer"
     when it changes here. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OpenShape-${version}-windows-x64-setup.exe" product-name="OpenShape" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
